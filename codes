local function setStatus(text, color)
	statusLabel.Text = text
	if color then
		stroke.Color = color
	end
end

local displayName = player.DisplayName or ""
local userName = player.Name or ""

local function stripRichText(text)
	return string.gsub(text, "<[^>]+>", "")
end

local function stripPrefix(text)
	for _, name in ipairs({ displayName, userName }) do
		if name ~= "" then
			local lowerName = string.lower(name)
			local lowerText = string.lower(text)
			if string.sub(lowerText, 1, #lowerName) == lowerName then
				text = string.sub(text, #name + 1)
				text = string.gsub(text, "^[%s%p:%-]+", "")
			end
		end
	end
	return text
end

local state = "idle"
local codeParts = {}
local lastStateChange = os.clock()
local TIMEOUT = 60

local function resetState()
	state = "idle"
	table.clear(codeParts)
	lastStateChange = os.clock()
	setStatus("Waiting for code...", Color3.fromRGB(60, 180, 255))
end

setWordCount = function(count)
	wordCount = count
	refreshToggleVisuals()
	if state == "collecting" then
		table.clear(codeParts)
		state = "idle"
	end
	setStatus("Mode: " .. count .. " words. Waiting for code...", Color3.fromRGB(60, 180, 255))
end

local function redeemCode(code)
	setStatus("Redeeming: " .. code .. "...", Color3.fromRGB(255, 200, 50))

	local RequestRedemption = Net:RemoteFunction("7d14a912-1040-4867-b005-98838eb9acc4")
	print("[AdminCodeAutoRedeemer] Sending code to server: " .. code)
	local ok, result, reason = pcall(function()
		return RequestRedemption:InvokeServer(code)
	end)
	print("[AdminCodeAutoRedeemer] Server response:", ok, result, tostring(reason))

	if not ok then
		setStatus("Redemption error: " .. tostring(result), Color3.fromRGB(255, 60, 60))
	elseif not result then
		setStatus("Failed: " .. tostring(reason or "Unknown"), Color3.fromRGB(255, 60, 60))
	else
		setStatus("Code redeemed! " .. tostring(reason or ""), Color3.fromRGB(50, 255, 100))
	end

	task.wait(4)
	if state == "redeeming" then
		resetState()
	end
end

local function processNotification(rawText)
	local cleanText = stripRichText(rawText)
	cleanText = stripPrefix(cleanText)
	cleanText = string.gsub(cleanText, "^%s+", "")
	cleanText = string.gsub(cleanText, "%s+$", "")
	local lowerText = string.lower(cleanText)

	print("[AdminCodeAutoRedeemer] Notification: " .. cleanText)

	local isTrigger = string.find(lowerText, "code is")
		or string.find(lowerText, "use code")
		or string.find(lowerText, "the code")

	if isTrigger then
		table.clear(codeParts)
		state = "collecting"
		lastStateChange = os.clock()
		print("[AdminCodeAutoRedeemer] Trigger detected! Entering collecting mode.")

		local afterTrigger = string.match(lowerText, "code is%s*(.*)")
			or string.match(lowerText, "use code%s*(.*)")
			or string.match(lowerText, "the code is%s*(.*)")
			or string.match(lowerText, "the code%s*(.*)")

		if afterTrigger and afterTrigger ~= "" then
			local originalAfter = string.match(cleanText, "[Cc][Oo][Dd][Ee]%s+[Ii][Ss]%s*(.*)")
				or string.match(cleanText, "[Uu][Ss][Ee]%s+[Cc][Oo][Dd][Ee]%s*(.*)")
				or string.match(cleanText, "[Tt][Hh][Ee]%s+[Cc][Oo][Dd][Ee]%s+[Ii][Ss]%s*(.*)")
				or string.match(cleanText, "[Tt][Hh][Ee]%s+[Cc][Oo][Dd][Ee]%s*(.*)")

			if originalAfter and originalAfter ~= "" then
				originalAfter = string.gsub(originalAfter, "^[%s%p]+", "")
				originalAfter = string.gsub(originalAfter, "%s+$", "")
				if originalAfter ~= "" then
					codeParts[1] = originalAfter
					setStatus("Part 1/" .. wordCount .. ": " .. originalAfter .. " - Waiting for word 2...", Color3.fromRGB(255, 200, 50))
					return
				end
			end
		end

		setStatus("Code detected! Waiting for word 1...", Color3.fromRGB(255, 200, 50))
		return
	end

	if state ~= "collecting" then
		return
	end

	if cleanText == "" then
		return
	end

	local nextPart = #codeParts + 1
	codeParts[nextPart] = cleanText
	lastStateChange = os.clock()

	if nextPart < wordCount then
		local display = table.concat(codeParts, " ")
		setStatus("Part " .. nextPart .. "/" .. wordCount .. ": " .. display .. " - Waiting for word " .. (nextPart + 1) .. "...", Color3.fromRGB(255, 200, 50))
	else
		local rawCode = table.concat(codeParts, "")
		local code = string.gsub(rawCode, "[^%w]", "")
		code = string.upper(code)

		if code == "" then
			setStatus("Code was empty, aborting.", Color3.fromRGB(255, 60, 60))
			task.wait(3)
			resetState()
			return
		end

		state = "redeeming"
		setStatus("All " .. wordCount .. " words received! Code: " .. code, Color3.fromRGB(50, 255, 100))
		task.spawn(function()
			redeemCode(code)
		end)
	end
end

-- Hook directly into the notification RemoteEvent (same one NotificationController uses)
local notifyEvent = Net:RemoteEvent("NotificationService/Notify")
notifyEvent.OnClientEvent:Connect(function(text, duration, sound, position, avatarUserId)
	if position == "Top" then
		processNotification(text)
	end
end)

print("[AdminCodeAutoRedeemer] Listening for notifications via NotificationService/Notify")

task.spawn(function()
	while true do
		task.wait(1)
		if state ~= "idle" and state ~= "redeeming" and (os.clock() - lastStateChange) > TIMEOUT then
			setStatus("Timed out waiting for code parts.", Color3.fromRGB(255, 60, 60))
			task.wait(3)
			resetState()
		end
	end
end)
